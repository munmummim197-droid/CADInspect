{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core-dev",
      "displayName": "Core development (MSVC x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs-core-dev",
      "cacheVariables": {
        "CMAKE_GENERATOR_INSTANCE": "C:/Program Files (x86)/Microsoft Visual Studio/18/BuildTools",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "STEPCOMPARE_BUILD_TESTS": "ON",
        "STEPCOMPARE_ENABLE_QT": "OFF",
        "STEPCOMPARE_ENABLE_OCCT": "OFF"
      }
    },
    {
      "name": "full-dev",
      "displayName": "Full dependency smoke (MSVC x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs-full-dev",
      "cacheVariables": {
        "CMAKE_GENERATOR_INSTANCE": "C:/Program Files (x86)/Microsoft Visual Studio/18/BuildTools",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_INSTALL": "OFF",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "STEPCOMPARE_BUILD_TESTS": "ON",
        "STEPCOMPARE_ENABLE_QT": "ON",
        "STEPCOMPARE_ENABLE_OCCT": "ON"
      }
    },
    {
      "name": "oss-release",
      "displayName": "OSS Release (Visual Studio 2022 x64)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs-oss-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_INSTALL": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "STEPCOMPARE_BUILD_TESTS": "ON",
        "STEPCOMPARE_ENABLE_QT": "ON",
        "STEPCOMPARE_ENABLE_OCCT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core-dev",
      "configurePreset": "core-dev",
      "configuration": "Debug"
    },
    {
      "name": "full-dev",
      "configurePreset": "full-dev",
      "configuration": "Debug"
    },
    {
      "name": "oss-release",
      "configurePreset": "oss-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "core-dev",
      "configurePreset": "core-dev",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "full-dev",
      "configurePreset": "full-dev",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "oss-release",
      "configurePreset": "oss-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
